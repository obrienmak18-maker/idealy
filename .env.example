# Configuration publique du navigateur — ces deux valeurs ne sont pas des secrets serveur.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Les clés privées ne doivent jamais être préfixées par VITE_ ni commit dans ce dépôt.
# Configurez-les comme secrets Supabase Edge Functions :
# SUPABASE_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# VERCEL_TOKEN
# GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET
# FIGMA_CLIENT_ID
# FIGMA_CLIENT_SECRET
