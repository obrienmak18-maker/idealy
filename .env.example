# Idealy local configuration template — never commit a file containing real values.
# Public browser variables only:
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Supabase CLI authentication is kept outside this file when possible.
SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_ACCESS_TOKEN=<supabase-account-token>

# Edge Function server secrets. Never prefix private values with VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
AI_KEY_ENCRYPTION_SECRET=<generate-a-random-64-character-secret>
GROQ_API_KEY=<managed-groq-key>
OPENROUTER_API_KEY=<managed-openrouter-key>
DEEPSEEK_API_KEY=<managed-deepseek-key>

# Stripe test mode.
STRIPE_SECRET_KEY=<stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-test-webhook-signing-secret>
STRIPE_PRICE_ID_PRO_MONTHLY=<pro-monthly-price-id>
STRIPE_PRICE_ID_PRO_YEARLY=<pro-yearly-price-id>
STRIPE_PRICE_ID_BUSINESS_MONTHLY=<business-monthly-price-id>
STRIPE_PRICE_ID_BUSINESS_YEARLY=<business-yearly-price-id>
# Legacy aliases kept for older CI fixtures; map them to the monthly IDs.
STRIPE_PRICE_ID_PRO=<pro-monthly-price-id>
STRIPE_PRICE_ID_BUSINESS=<business-monthly-price-id>

# Designer server integrations.
PEXELS_API_KEY=<pexels-api-key>
OPENAI_API_KEY=<server-side-image-generation-key>
# Use IMAGE_GENERATION_API_KEY instead only when a different compatible provider is selected.
# IMAGE_GENERATION_API_KEY=<compatible-image-generation-key>
# IMAGE_GENERATION_API_URL=https://provider.example/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional deployment and OAuth configuration.
VERCEL_TOKEN=<vercel-token>
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
IDEALY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PROVIDER_CONFIGS=<server-provider-config-json>
# GITHUB_CLIENT_ID=<oauth-client-id>
# GITHUB_CLIENT_SECRET=<oauth-client-secret>
# GITHUB_OAUTH_CLIENT_ID=<oauth-client-id>
# GITHUB_OAUTH_CLIENT_SECRET=<oauth-client-secret>
# INTEGRATION_ENCRYPTION_KEY=<existing-integration-encryption-key>
