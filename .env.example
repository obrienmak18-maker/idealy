# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Vercel fournit OIDC automatiquement pour les services Vercel compatibles.
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Supabase PostgreSQL connection string (use the IDEALY project's pooler/direct connection as appropriate).
# Drizzle may remain as the SQL adapter for legacy chat tables; it must point at the same IDEALY Supabase database.
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Mode local de démonstration : true contourne l’authentification et la base réelle.
# En production, utiliser false.
DEMO_MODE=false

# URL publique exacte du projet Vercel ou du domaine personnalisé Idealy.
NEXT_PUBLIC_SITE_URL=https://idealy.app

# Fournisseur IA principal du workspace : gateway ou supabase-function.
# Production should use the Supabase function path so provider keys stay in Supabase Secrets.
IDEALY_AI_PROVIDER=gateway

# URL interne du backend Idealy importé.
IDEALY_API_URL=http://localhost:3001
# URL optionnelle de la Supabase Edge Function IA.
IDEALY_AI_FUNCTION_URL=http://localhost:3001/functions/v1/process-ai-request

# Connexion serveur au projet Supabase IDEALY.
# SUPABASE_ANON_KEY est une clé publishable ; elle ne remplace jamais le service role.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=****
# À configurer dans Supabase Edge Function Secrets : origines exactes séparées par des virgules.
# Exemple : https://mon-projet.vercel.app,https://www.idealy.app,http://localhost:3000
IDEALY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.idealy.app
APP_ORIGIN=https://www.idealy.app

# Les secrets des fournisseurs IA de la fonction Supabase doivent être configurés
# dans Supabase Edge Function Secrets, jamais dans le navigateur ni dans Git.
# Exemples gérés côté Supabase : SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY,
# AI_KEY_ENCRYPTION_SECRET, ANTHROPIC_API_KEY, DEEPSEEK_API_KEY,
# GEMINI_API_KEY, GROQ_API_KEY, MOONSHOT_API_KEY, OPENAI_API_KEY,
# OPENROUTER_API_KEY, TOGETHER_API_KEY.
# Catalogue facultatif (JSON) pour limiter les modèles autorisés par provider :
# IDEALY_PROVIDER_MODELS_JSON={}
# Active l’affichage des modèles directs dans le catalogue UI lorsque true :
# NEXT_PUBLIC_IDEALY_DIRECT_MODEL_CATALOG=false

# Configuration publique Firebase Web pour Google Sign-In.
# Ne jamais y placer de clé privée, de service account ou de secret serveur.
NEXT_PUBLIC_FIREBASE_API_KEY= # Injected from the project variable apiKey_2
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gen-lang-client-0338545186.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gen-lang-client-0338545186
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gen-lang-client-0338545186.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=796636377163
NEXT_PUBLIC_FIREBASE_APP_ID=1:796636377163:web:19372def99061e37021dce
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XCSE5WPF9M

# Configuration Firebase Admin, côté serveur uniquement. Requise pour vérifier
# les jetons et synchroniser le rôle authenticated vers Supabase.
# Ne jamais préfixer ces variables par NEXT_PUBLIC_ et ne jamais les commiter.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Contrôle des paiements Stripe (désactivé par défaut pour la phase de démonstration / jury)
IDEALY_PAYMENTS_ENABLED=false
NEXT_PUBLIC_IDEALY_PAYMENTS_ENABLED=false

# Quota strict de générations gratuites par utilisateur avant blocage bienveillant (défaut : 5)
IDEALY_FREE_GENERATION_LIMIT=5

# StackBlitz WebContainers Configuration
# Identifiant client StackBlitz (si utilisation de l'API cloud WebContainers)
NEXT_PUBLIC_WEBCONTAINER_CLIENT_ID=
